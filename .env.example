# ---------------------------------------------------------------------------
# Gatewise environment configuration.
# Copy to `.env` and fill in real values. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Decision model (required to run any evaluation) ------------------------
# TYPESAFE_API_KEY is the variable the official typesafe-sdk reads.
# Obtain a key from https://typesafe.ai
# JEV_API_KEY is accepted as a legacy alias for the above.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Optional; override only for self-hosted deployments.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=10.0

# --- GitHub App (required for webhook ingestion) ----------------------------
GITHUB_APP_ID=
# PEM contents. Keep newlines escaped as \n, or point at a mounted file.
GITHUB_PRIVATE_KEY=
# Used to verify webhook signatures. Required; unsigned webhooks are rejected.
GITHUB_WEBHOOK_SECRET=

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./gatewise.db
# Only needed if asynchronous processing is introduced.
# REDIS_URL=redis://localhost:6379/0

# --- Dashboard --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
